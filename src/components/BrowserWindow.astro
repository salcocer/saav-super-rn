---
interface Props {
  id: string;
  url: string;
  class?: string;
}

const { id, url, class: className } = Astro.props;
const shownUrl = url.replace(/^(https?:\/\/|mailto:)/, "").replace(/\/$/, "");
const isMail = url.startsWith("mailto:");
---

<div
  id={id}
  data-modal
  class="modal-overlay hidden fixed inset-0 z-50 items-center justify-center p-4 bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300 ease-out"
>
  <div
    role="dialog"
    aria-modal="true"
    aria-label={shownUrl}
    data-modal-panel
    class="relative w-full max-w-[1000px] h-[85vh] flex flex-col overflow-hidden rounded-xl shadow-2xl border border-white/10 bg-neutral-900 text-white scale-95 opacity-0 transition-all duration-300 ease-out"
  >
    <div
      class="traffic-bar relative flex items-center h-11 px-4 shrink-0 bg-neutral-800 border-b border-black/50"
    >
      <div class="relative z-10 flex items-center gap-2">
        <button
          type="button"
          data-modal-close
          aria-label="Close"
          title="Close"
          class="traffic-light bg-[#ff5f57]"><span>×</span></button
        >
        <button
          type="button"
          data-modal-close
          aria-label="Minimize"
          title="Minimize"
          class="traffic-light bg-[#febc2e]"><span>−</span></button
        >
        <a
          href={url}
          target={isMail ? undefined : "_blank"}
          rel="noopener noreferrer"
          aria-label="Open in new tab"
          title="Open in new tab"
          class="traffic-light bg-[#28c840]"><span>+</span></a
        >
      </div>
      <div class="absolute inset-0 flex items-center justify-center px-24">
        <div
          class="w-full max-w-md truncate rounded-md bg-neutral-900/80 px-3 py-1 text-center text-xs text-white/70 select-all"
        >
          🔒 {shownUrl}
        </div>
      </div>
    </div>
    <div class={`flex-1 overflow-auto ${className ?? ""}`}>
      <slot />
    </div>
  </div>
</div>

<style>
  .modal-overlay:not(.hidden) {
    display: flex;
  }

  .traffic-light {
    width: 12px;
    height: 12px;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    color: rgb(0 0 0 / 0.6);
    box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.25);
  }

  .traffic-light span {
    opacity: 0;
    transition: opacity 150ms;
  }

  .traffic-bar:hover .traffic-light span,
  .traffic-light:focus-visible span {
    opacity: 1;
  }
</style>
