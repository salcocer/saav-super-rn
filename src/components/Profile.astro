---
import Modal from "./Modal.astro";
---

<div
  class="m-auto p-4 w-[280px] h-fit relative bg-black/20 backdrop-blur-lg rounded-lg shadow-lg hover:shadow-2xl hover:-translate-y-1 transition-transform duration-300 text-white flex flex-col items-start border border-transparent hover:border-gray-400 cursor-pointer"
  data-modal-target="profile-modal"
  role="button"
  tabindex="0"
  aria-haspopup="dialog"
>
  <img
    src="profile.jpeg"
    alt="Profile Picture"
    class="hover:scale-125 transition rounded-full shadow-md w-28 h-28 object-cover"
  />
  <div class="mt-4">
    <h1 class="text-xl font-bold">Alejandro Alcocer</h1>
    <p class="text-md mt-2">alealcocer08@gmail.com</p>
    <!-- <p class="text-md mt-2">📍 Based in Spain</p> -->
    <!-- <p class="text-md mt-2">📞 +34 600 000 000</p> -->
  </div>
</div>

<Modal id="profile-modal">
  <div class="p-8 flex flex-col items-center text-center">
    <img
      src="profile.jpeg"
      alt="Profile Picture"
      class="rounded-full shadow-md w-40 h-40 object-cover"
    />
    <h1 class="text-xl font-bold text-white mt-4">Alejandro Alcocer</h1>
    <p class="text-md mt-2 text-white">alealcocer08@gmail.com</p>
    <!-- Add more profile details here (location, phone, tagline, etc.) -->
  </div>
</Modal>
