---
import IconApp from "./IconApp.astro";
import Modal from "./Modal.astro";
---

<div
  class="mx-auto w-[394px] lg:w-[409px] h-fit bg-black/20 backdrop-blur-lg rounded-lg shadow-lg hover:shadow-2xl hover:-translate-y-1 transition-transform duration-300 text-white flex-col items-start border border-transparent hover:border-gray-400 transition cursor-pointer"
  data-modal-target="technologies-modal"
  role="button"
  tabindex="0"
  aria-haspopup="dialog"
>
  <div
    class="p-6 bg-black/10 backdrop-blur-lg h-1 flex items-center rounded-t-lg"
  >
    <h2 class="text-base font-semibold text-white">Technologies</h2>
  </div>
  <div class="p-6 flex-wrap flex justify-start gap-4">
    <!-- <IconApp src="laravel.png" title="laravel" /> -->
    <IconApp src="js.png" title="javascript" />
    <IconApp src="typescript.png" title="typescript" />
    <IconApp src="react.png" title="react" />
    <IconApp src="redux.png" title="redux" />
    <IconApp src="astro.png" title="astro" />
    <IconApp src="cypress.png" title="cypress" />
    <IconApp src="expo.png" title="expo" />
    <!-- <IconApp src="styled.png" title="styled" /> -->
    <IconApp src="threejs.png" title="threejs" />
    <!-- <IconApp src="java.png" title="java" /> -->
    <IconApp src="springboot.png" title="spring_boot" />
    <!-- <IconApp src="php.png" title="php" /> -->
  </div>
</div>

<Modal id="technologies-modal">
  <div
    class="p-6 bg-black/10 backdrop-blur-lg h-1 flex items-center rounded-t-lg"
  >
    <h2 class="text-xl mt-4 font-semibold text-white">Technologies</h2>
  </div>
  <div class="p-6 flex-wrap flex justify-start gap-6">
    <!-- <IconApp src="laravel.png" title="laravel" /> -->
    <IconApp src="js.png" title="javascript" />
    <IconApp src="typescript.png" title="typescript" />
    <IconApp src="react.png" title="react" />
    <IconApp src="redux.png" title="redux" />
    <IconApp src="astro.png" title="astro" />
    <IconApp src="cypress.png" title="cypress" />
    <IconApp src="expo.png" title="expo" />
    <!-- <IconApp src="styled.png" title="styled" /> -->
    <IconApp src="threejs.png" title="threejs" />
    <!-- <IconApp src="java.png" title="java" /> -->
    <IconApp src="springboot.png" title="spring_boot" />
    <!-- <IconApp src="php.png" title="php" /> -->
  </div>
  <div class="px-6 pb-6 flex flex-col gap-4">
    {
      [
        {
          label: "Mobile",
          items: [
            "React",
            "React Native",
            "Expo",
            "Detox",
            "React Navigation",
            "Zustand",
            "Redux",
            "React Native Paper",
            "TypeScript",
            "JavaScript",
            "Swift",
          ],
        },
        {
          label: "Backend",
          items: ["Java", "Spring Boot", "JPA", "Maven", "Microservices"],
        },
        { label: "Databases", items: ["PostgreSQL", "MongoDB"] },
        { label: "DevOps", items: ["Docker", "GitHub Actions & CI/CD"] },
        {
          label: "Testing",
          items: ["Detox", "Cypress", "Vitest", "Mockito"],
        },
        {
          label: "Architecture",
          items: ["Microservices", "RESTful APIs"],
        },
        { label: "Methodologies", items: ["Agile", "Scrum"] },
        {
          label: "Tools",
          items: ["VS Code", "Eclipse", "IntelliJ IDEA", "Xcode", "Copilot"],
        },
      ].map((group) => (
        <div>
          <p class="text-sm font-semibold text-white">{group.label}</p>
          <div class="flex flex-wrap gap-2 mt-1.5">
            {group.items.map((item) => (
              <span class="bg-white/10 text-white text-xs px-2 py-1 rounded">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</Modal>
