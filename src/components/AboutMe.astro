---
import Modal from "./Modal.astro";
---

<div
  class="w-[400px] lg:w-fit lg:h-[430px] m-auto bg-black/20 backdrop-blur-lg rounded-lg shadow-lg hover:shadow-2xl hover:-translate-y-1 transition-transform duration-300 text-white flex-col items-start border border-transparent hover:border-gray-400 transition cursor-pointer"
  data-modal-target="about-me-modal"
  role="button"
  tabindex="0"
  aria-haspopup="dialog"
>
  <div
    class="p-6 bg-black/10 backdrop-blur-lg h-1 flex items-center rounded-t-lg"
  >
    <h2 class="text-lg font-semibold text-white">About Me</h2>
  </div>
  <p class="p-2 text-[15px] mt-2 text-white text-wrap text-pretty">
    Mobile & Frontend Developer with 5+ years of experience building scalable
    mobile and web applications using React Native, React, and Expo. Skilled in
    TypeScript, APIs, Microservices, PostgreSql, MongoDB & Docker. Experienced
    in developing responsive UI/UX, integrating backend services, and working in
    Agile & Scrum environments.
  </p>
</div>

<Modal id="about-me-modal">
  <div
    class="p-6 bg-black/10 backdrop-blur-lg h-1 flex items-center rounded-t-lg"
  >
    <h2 class="text-lg font-semibold text-white">About Me</h2>
  </div>
  <p class="p-6 text-[15px] text-white text-wrap text-pretty">
    Mobile & Frontend Developer with 5+ years of experience building
    scalable mobile and web applications using React Native, React, and
    Expo. Skilled in TypeScript, APIs, Microservices, PostgreSql, MongoDB &
    Docker. Experienced in developing responsive UI/UX, integrating backend
    services, and working in Agile & Scrum environments.
  </p>
  <!-- Add more details here (goals, interests, longer bio, etc.) -->
</Modal>
