---
import Modal from "./Modal.astro";
---

<div
  class="w-[394px] lg:w-fit lg:h-[438px] mx-auto bg-black/20 backdrop-blur-lg rounded-lg shadow-lg hover:shadow-2xl hover:-translate-y-1 transition-transform duration-300 text-white flex-col items-start border border-transparent hover:border-gray-400 transition cursor-pointer"
  data-modal-target="about-me-modal"
  role="button"
  tabindex="0"
  aria-haspopup="dialog"
>
  <div
    class="p-6 bg-black/10 backdrop-blur-lg h-1 flex items-center rounded-t-lg"
  >
    <h2 class="text-base font-semibold text-white">About Me</h2>
  </div>
  <p class="p-4 text-sm mt-2 text-white text-wrap text-pretty">
    Mobile & Frontend Developer with 5+ years of experience building scalable
    mobile and web applications using React Native, React, and Expo. Skilled in
    TypeScript, APIs, Microservices, PostgreSql, MongoDB & Docker. Experienced
    in developing responsive UI/UX, integrating backend services, and working in
    Agile & Scrum environments.
  </p>
</div>

<Modal id="about-me-modal">
  <div
    class="p-6 bg-black/10 backdrop-blur-lg h-1 flex items-center rounded-t-lg"
  >
    <h2 class="text-xl mt-4 font-semibold text-white">About Me</h2>
  </div>
  <p class="p-6 pb-3 text-[15px] text-white text-wrap text-pretty">
    Mobile & Frontend Developer with 5+ years of experience building scalable
    mobile and web applications using React Native, React, and Expo. Skilled in
    TypeScript, APIs, Microservices, PostgreSql, MongoDB & Docker. Experienced
    in developing responsive UI/UX, integrating backend services, and working in
    Agile & Scrum environments. Also build backend services with Java & Spring
    Boot, with a particular interest in trading systems, prediction markets, and
    crypto.
  </p>
  <div class="px-6 pb-6">
    <p class="text-sm font-semibold text-white">Languages</p>
    <div class="flex flex-wrap gap-2 mt-1.5">
      <span class="bg-white/10 text-white text-xs px-2 py-1 rounded"
        >Spanish — Native</span
      >
      <span class="bg-white/10 text-white text-xs px-2 py-1 rounded"
        >English — Fluent</span
      >
    </div>
  </div>
</Modal>
