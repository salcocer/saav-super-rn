---
import Modal from "./Modal.astro";
---

<div
  class="mx-auto w-full lg:w-[710px] h-full lg:h-fit lg:ml-[45px] max-lg:overflow-hidden bg-black/20 backdrop-blur-lg rounded-lg shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-transform duration-300 text-white flex-col items-start border border-transparent hover:border-gray-500 transition cursor-pointer"
  data-modal-target="experience-modal"
  role="button"
  tabindex="0"
  aria-haspopup="dialog"
>
  <div
    class="p-6 bg-black/10 backdrop-blur-lg h-1 flex items-center rounded-t-lg"
  >
    <h2 class="text-base font-semibold text-white">Experience</h2>
  </div>
  <div class="p-4 lg:p-6">
    <div class="flex flex-col lg:flex-row lg:justify-between">
      <p class="text-sm text-white">
        · T-Systems, Barcelona - Mobile Developer
      </p>
      <p class="text-xs text-white italic">May 2022 - Present</p>
    </div>
    <div class="flex flex-col lg:flex-row lg:justify-between mt-3">
      <p class="text-sm text-white">· Idrica, Valencia - FrontEnd Developer</p>
      <p class="text-xs text-white italic">April 2021 - May 2022</p>
    </div>
    <div class="flex flex-col lg:flex-row lg:justify-between mt-3">
      <p class="text-sm text-white">· Pccom, Alicante - Mobile Developer</p>
      <p class="text-xs text-white italic">March 2019 - May 2021</p>
    </div>
  </div>
</div>

<Modal id="experience-modal" class="max-w-[912px]">
  <div
    class="p-6 bg-black/10 backdrop-blur-lg h-1 flex items-center rounded-t-lg"
  >
    <h2 class="text-2xl mt-4 font-semibold text-white">Experience</h2>
  </div>
  <div class="p-6 flex flex-col gap-14">
    <div>
      <div class="flex flex-row justify-between">
        <p class="text-lg text-white font-semibold">
          T-Systems, Barcelona - Mobile Developer
        </p>
        <p class="text-sm text-white italic">May 2022 - Present</p>
      </div>
      <ul class="mt-2 ml-8 list-disc space-y-1 text-sm text-gray-300">
        <li>
          Development and maintenance of mobile apps using React Native + Expo.
        </li>
        <li>
          Integration of development workflows and CI/CD processes using GitHub
          and GitHub Actions.
        </li>
        <li>Development and integration of REST APIs and Microservices.</li>
        <li>Monitoring and improving mobile UI and UX.</li>
        <li>
          <span class="text-white">Electronic Processing</span> (Tramitación Electrónica):
          platform for the full lifecycle management of interoperable electronic documents
          and administrative processes.
        </li>
        <li>
          <span class="text-white">Financial Management</span> (Gestión Económica):
          digital public accounting solution with decentralized management and fully
          electronic processing focused on third-party roles as creditors or debtors.
        </li>
      </ul>
      <div class="flex flex-wrap gap-2 mt-3 ml-8">
        {
          [
            "TypeScript",
            "Vite",
            "Jest",
            "Expo",
            "Detox",
            "Zustand",
            "Redux",
            "React Navigation",
          ].map((tech) => (
            <span class="bg-white/10 text-white text-xs px-2 py-1 rounded">
              {tech}
            </span>
          ))
        }
      </div>
    </div>
    <div>
      <div class="flex flex-row justify-between">
        <p class="text-lg text-white font-semibold">
          Idrica, Valencia - FrontEnd Developer
        </p>
        <p class="text-sm text-white italic">April 2021 - May 2022</p>
      </div>
      <ul class="mt-2 ml-8 list-disc space-y-1 text-sm text-gray-300">
        <li>Development of React applications based on UI designs.</li>
        <li>
          Development and maintenance of public and private npm libraries.
        </li>
        <li>
          <span class="text-white">Meter Data Analytics:</span> integrated remote
          meter readings, indoor leak detection using AI, and meter lifecycle management.
        </li>
        <li>
          <span class="text-white">Billing:</span> enhanced utility processes for
          meter reading, billing, debt collection, and payment management.
        </li>
      </ul>
      <div class="flex flex-wrap gap-2 mt-3 ml-8">
        {
          ["TypeScript", "Node", "NestJS", "Docker", "Cypress"].map((tech) => (
            <span class="bg-white/10 text-white text-xs px-2 py-1 rounded">
              {tech}
            </span>
          ))
        }
      </div>
    </div>
    <div>
      <div class="flex flex-row justify-between">
        <p class="text-lg text-white font-semibold">
          Pccom, Alicante - Mobile Developer
        </p>
        <p class="text-sm text-white italic">March 2019 - May 2021</p>
      </div>
      <ul class="mt-2 ml-8 list-disc space-y-1 text-sm text-gray-300">
        <li>Development and maintenance of apps using React Native + Expo.</li>
        <li>Development based on designs from the UI team using Figma.</li>
        <li>Publishing applications to the App Store and Google Play.</li>
        <li>
          <span class="text-white">KetePongo-Business:</span> mobile ERP for food
          service providers, including order management, invoicing, route planning,
          and calendar scheduling.
        </li>
        <li>
          <span class="text-white">KetePongo:</span> client-facing app, synchronized
          with the business version to enable automated ordering and end-to-end traceability.
        </li>
      </ul>
      <div class="flex flex-wrap gap-2 mt-3 ml-8">
        {
          ["Swift", "Xcode", "TypeScript", "Expo", "C#", ".NET"].map((tech) => (
            <span class="bg-white/10 text-white text-xs px-2 py-1 rounded">
              {tech}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</Modal>
