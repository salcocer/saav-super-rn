---
import BrowserWindow from "./BrowserWindow.astro";

interface Props {
  id: string;
  /** Panel width; defaults to max-w-[752px]. */
  class?: string;
}

const { id, class: className } = Astro.props;
const path = id.replace(/-modal$/, "");
---

<BrowserWindow
  id={id}
  address={`saav-super.onrender.com/${path}`}
  size={`${className ?? "max-w-[752px]"} max-h-[85vh]`}
>
  <slot />
</BrowserWindow>
