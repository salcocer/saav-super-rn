---
import IconApp from "./IconApp.astro";
import Modal from "./Modal.astro";

const projects = [
  {
    title: "Memento",
    tagline: "Expo + React Native App",
    icon: "calendar.png",
    href: "https://github.com/TutoryOrg/JWService",
    description:
      "One codebase shipping to Android, iOS, and Web with Expo + React Native, backed by a real Figma-to-code design workflow, Storybook for component review, and i18n baked in from the start.",
  },
  {
    title: "Trivial",
    tagline: "React Native App",
    icon: "trivial.png",
    href: "https://github.com/TutoryOrg/JWTrivial",
    description:
      "A full-stack trivia game split into a dedicated backend (jwback) and React Native client (jwgame), taken all the way from Figma mockups and data-flow diagrams to a working iOS build.",
  },
  {
    title: "TP_Academy",
    tagline: "Astro",
    icon: "logo.png",
    href: "https://github.com/TutoryOrg/phuketacademy",
    description:
      "Marketing site for a football academy in Phuket, built with Astro and Tailwind CSS for a fast, mostly-static site with minimal JS shipped to the browser.",
  },
  {
    title: "TaxiMap",
    tagline: "React Native Maps",
    icon: "taxi.png",
    href: "https://github.com/salcocer/react-native-maps",
    description:
      "A taxi-booking concept centered on Madrid, exploring react-native-maps for interactive maps and location-based UX in an Expo + TypeScript app.",
  },
  {
    title: "CrashBombs",
    tagline: "React Native + Expo Game",
    icon: "expo.png",
    href: "https://github.com/TutoryOrg/CrashBombs",
    description:
      "An arcade game built with React Native + Expo, with Supabase-backed sign in/sign up (email & Google, Apple ID in progress), a custom game engine, and a companion marketing website.",
  },
  {
    title: "OnlyChat",
    tagline: "Chat App | Nextjs + Facebook Graph API",
    icon: "typescript.png",
    href: "https://github.com/salcocer/ig_api_project",
    description:
      "A distraction-free chat app for staying connected without the social-media rabbit hole — chat backend, a Chrome extension, and a Next.js website in one repo.",
  },
];
---

<div
  class="w-[394px] lg:w-[274px] lg:h-[399px] bg-black/20 backdrop-blur-lg rounded-lg shadow-lg hover:shadow-2xl hover:-translate-y-1 transition-transform duration-300 text-white max-w-lg mx-auto flex-col items-start border border-transparent hover:border-gray-400 transition cursor-pointer"
  data-modal-target="projects-modal"
  role="button"
  tabindex="0"
  aria-haspopup="dialog"
>
  <div
    class="p-6 bg-black/10 backdrop-blur-lg h-1 flex items-center rounded-t-lg"
  >
    <h2 class="text-base font-semibold text-white">Projects</h2>
  </div>
  <div class="p-4 grid grid-cols-1 lg:grid-cols-2 gap-4 justify-center">
    <div class="flex flex-col items-center p-4 rounded-lg">
      <IconApp
        href="https://github.com/TutoryOrg/JWService"
        src="calendar.png"
        title="Expo + React Native App"
      />
      <p class="text-sm">Memento</p>
    </div>
    <div class="flex flex-col items-center p-4 rounded-lg">
      <IconApp
        href="https://github.com/TutoryOrg/JWTrivial"
        src="trivial.png"
        title="React Native App"
      />
      <p class="text-sm">Trivial</p>
    </div>
    <div class="flex flex-col items-center p-4 rounded-lg">
      <IconApp
        href="https://github.com/TutoryOrg/phuketacademy"
        src="logo.png"
        title="Football Academy"
      />
      <p class="text-sm">TP_Academy</p>
    </div>
    <div class="flex flex-col items-center p-4 rounded-lg">
      <IconApp
        href="https://github.com/salcocer/react-native-maps"
        src="taxi.png"
        title="TaxiMap"
      />
      <p class="text-sm">TaxiMap</p>
    </div>
    <div>
      <p class="text-2xl ml-6">...</p>
    </div>
    <!-- <div class="flex flex-col items-center p-4 rounded-lg">
      <IconApp
        href="https://github.com/TutoryOrg/CrashBombs"
        src="expo.png"
        title="React Native + Expo Game"
      />
      <p class="text-sm">CrashBombs</p>
    </div>
    <div class="flex flex-col items-center p-4 rounded-lg">
      <IconApp
        href="https://github.com/salcocer/ig_api_project"
        src="typescript.png"
        title="Chat App"
      />
      <p class="text-sm">OnlyChat</p>
    </div> -->
  </div>
</div>

<Modal id="projects-modal" class="max-w-[820px]">
  <div
    class="p-6 bg-black/10 backdrop-blur-lg h-1 flex items-center rounded-t-lg"
  >
    <h2 class="text-xl mt-4 font-semibold text-white">Projects</h2>
  </div>
  <div class="p-6" data-carousel>
    <div class="relative px-14">
      <button
        type="button"
        data-carousel-prev
        aria-label="Previous project"
        class="absolute left-2 top-1/2 -translate-y-1/2 z-10 w-9 h-9 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 transition text-white"
      >
        ‹
      </button>
      <div class="overflow-hidden">
        <div class="flex" data-carousel-track>
          {
            projects.map((project) => (
              <div class="w-full shrink-0 flex items-center gap-8 px-2 min-h-[190px]">
                <img
                  src={project.icon}
                  alt={project.title}
                  class="w-28 h-28 shrink-0 rounded-lg object-cover bg-white/5 p-2"
                />
                <div class="flex flex-col gap-3">
                  <h3 class="text-lg font-semibold text-white">
                    {project.title}
                  </h3>
                  <p class="text-sm text-white/60 italic">{project.tagline}</p>
                  <p class="text-sm text-gray-300">{project.description}</p>
                  <a
                    href={project.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm text-white underline underline-offset-2 hover:text-white/80 w-fit"
                  >
                    View project
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <button
        type="button"
        data-carousel-next
        aria-label="Next project"
        class="absolute right-2 top-1/2 -translate-y-1/2 z-10 w-9 h-9 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 transition text-white"
      >
        ›
      </button>
    </div>
    <div class="flex items-center justify-center gap-2 mt-8">
      {
        projects.map((project, i) => (
          <button
            type="button"
            data-carousel-dot
            data-index={i}
            aria-label={`Go to ${project.title}`}
            class:list={[
              "w-2 h-2 rounded-full transition",
              i === 0 ? "bg-white" : "bg-white/30",
            ]}
          />
        ))
      }
    </div>
  </div>
</Modal>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-carousel]")
    .forEach((carousel) => {
      const track = carousel.querySelector<HTMLElement>(
        "[data-carousel-track]",
      );
      if (!track) return;
      const slides = Array.from(track.children) as HTMLElement[];
      const prevBtn = carousel.querySelector<HTMLElement>(
        "[data-carousel-prev]",
      );
      const nextBtn = carousel.querySelector<HTMLElement>(
        "[data-carousel-next]",
      );
      const dots = Array.from(
        carousel.querySelectorAll<HTMLElement>("[data-carousel-dot]"),
      );
      let index = 0;

      function update() {
        track!.style.transform = `translateX(-${index * 100}%)`;
        dots.forEach((dot, i) => {
          dot.classList.toggle("bg-white", i === index);
          dot.classList.toggle("bg-white/30", i !== index);
        });
      }

      prevBtn?.addEventListener("click", () => {
        index = (index - 1 + slides.length) % slides.length;
        update();
      });
      nextBtn?.addEventListener("click", () => {
        index = (index + 1) % slides.length;
        update();
      });
      dots.forEach((dot, i) => {
        dot.addEventListener("click", () => {
          index = i;
          update();
        });
      });
    });
</script>
